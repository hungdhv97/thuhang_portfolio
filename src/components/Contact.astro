---
import { contact } from "../data/content";
---

<section
  id="contact"
  class="reveal section-atmosphere"
  aria-labelledby="contact-heading"
>
  <div class="pt-10 md:pt-14">
    <h2
      id="contact-heading"
      class="font-display text-[clamp(2.05rem,5.25vw,3rem)] tracking-[-0.02em]"
    >
      Liên hệ
    </h2>
    <p
      class="mt-4 max-w-[min(28ch,100%)] font-display text-[clamp(1.55rem,4.5vw,2.35rem)] leading-[1.15] tracking-[-0.02em] md:mt-5"
    >
      Cùng làm rõ bài toán tiếp theo.
    </p>
    <dl class="mt-10 m-0 grid gap-6 sm:grid-cols-2 sm:gap-8 md:mt-12">
      <div class="min-w-0">
        <dt class="label text-[var(--color-ink-soft)]">Email</dt>
        <dd class="m-0 mt-2">
          <a
            href={`mailto:${contact.email}`}
            class="cta-text cta-text-break text-lg md:text-xl"
          >
            {contact.email}
          </a>
        </dd>
      </div>
      <div class="min-w-0">
        <dt class="label text-[var(--color-ink-soft)]">Điện thoại</dt>
        <dd class="m-0 mt-2">
          <a
            href={`tel:${contact.phone.replace(/\s/g, "")}`}
            class="cta-text text-lg md:text-xl"
          >
            {contact.phone}
          </a>
        </dd>
      </div>
    </dl>
  </div>
</section>
