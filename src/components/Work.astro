---
import { work, workMarks } from "../data/content";
---

<section id="work" class="reveal section-space" aria-labelledby="work-heading">
  <header class="work-header">
    <h2
      id="work-heading"
      class="font-display text-[clamp(2.05rem,5.25vw,3rem)] tracking-[-0.02em]"
    >
      Công việc
    </h2>
    <p class="mt-3 max-w-[min(40ch,100%)] text-base text-[var(--color-ink-soft)] md:mt-4 md:text-lg">
      Mỗi case: vấn đề → việc làm → kết quả.
    </p>
  </header>

  <ul class="work-list mt-8 list-none space-y-0 p-0 md:mt-12">
    {
      work.map((item, index) => {
        const mark = workMarks[item.id] ?? "flow";
        const offset = index % 2 === 1;
        return (
          <li
            class:list={[
              "work-item",
              offset && "work-item-offset",
            ]}
          >
            <article class="work-case">
              <div class="work-case-index font-display" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </div>

              <div class="work-case-body min-w-0">
                <div class="work-case-title-row">
                  <h3 class="font-display work-case-title">{item.name}</h3>
                  <p class="work-case-meta">
                    <span>{item.company}</span>
                    <span class="work-case-meta-sep" aria-hidden="true">
                      ·
                    </span>
                    <span>{item.role}</span>
                  </p>
                </div>

                <dl class="work-case-steps">
                  <div class="work-step">
                    <dt class="label">Vấn đề</dt>
                    <dd>{item.problem}</dd>
                  </div>
                  <div class="work-step">
                    <dt class="label">Việc làm</dt>
                    <dd>{item.action}</dd>
                  </div>
                  <div class="work-step work-step-result">
                    <dt class="label">Kết quả</dt>
                    <dd>{item.result}</dd>
                  </div>
                </dl>

                {item.note ? (
                  <p class="work-case-note">{item.note}</p>
                ) : null}

                <p class="label work-case-tags">{item.tags.join(" · ")}</p>
              </div>

              <div
                class:list={["mark", "work-case-mark", `mark-${mark}`]}
                aria-hidden="true"
              />
            </article>
          </li>
        );
      })
    }
  </ul>
</section>
