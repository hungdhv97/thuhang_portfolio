---
import { work, workMarks } from "../data/content";
---

<section id="work" class="reveal mb-24 md:mb-40" aria-labelledby="work-heading">
  <h2
    id="work-heading"
    class="font-display text-[clamp(2.05rem,5.25vw,3rem)] tracking-[-0.02em]"
  >
    Công việc
  </h2>
  <p
    class="mt-4 max-w-[min(22ch,100%)] font-display text-[clamp(1.55rem,4.5vw,2.35rem)] leading-[1.15] tracking-[-0.02em] md:mt-5"
  >
    Dự án tiêu biểu
  </p>
  <p class="mt-4 max-w-[min(36ch,100%)] text-lg text-[var(--color-ink-soft)] md:mt-5">
    Từ yêu cầu rối đến hệ thống chạy: prototype, SRS, đào tạo, golive.
  </p>

  <ul class="work-list mt-10 list-none space-y-0 p-0 md:mt-14">
    {
      work.map((item, index) => {
        const mark = workMarks[item.id] ?? "flow";
        const offset = index % 2 === 1;
        return (
          <li
            class:list={[
              "work-item border-t border-[var(--color-rule)] py-8 last:border-b md:py-10",
              offset && "md:pl-10",
            ]}
          >
            <div class="grid gap-3 md:grid-cols-[5.5rem_minmax(0,1fr)] md:gap-10">
              <span class="font-display text-[2.1rem] leading-none tracking-[-0.04em] text-[var(--color-accent)] md:pt-1 md:text-[2.5rem]">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div class="min-w-0">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <h3 class="font-display text-[1.55rem] tracking-[-0.02em] md:text-[2.05rem]">
                    {item.name}
                  </h3>
                  <span class="text-base text-[var(--color-ink-soft)]">
                    {item.company}
                  </span>
                </div>
                <p class="mt-1 text-base text-[var(--color-accent)]">
                  {item.role}
                </p>
                <p class="mt-4 max-w-[48ch] text-lg leading-relaxed text-[var(--color-ink)] md:mt-5">
                  {item.impact}
                </p>
                {item.detail ? (
                  <p class="mt-2 max-w-[48ch] text-base leading-relaxed text-[var(--color-ink-soft)]">
                    {item.detail}
                  </p>
                ) : null}
                {item.note ? (
                  <p class="mt-3 text-base text-[var(--color-ink-soft)]">
                    {item.note}
                  </p>
                ) : null}
                <p class="label mt-4 text-[var(--color-ink-soft)] md:mt-5">
                  {item.tags.join(" · ")}
                </p>
                <div
                  class:list={["mark", `mark-${mark}`]}
                  aria-hidden="true"
                />
              </div>
            </div>
          </li>
        );
      })
    }
  </ul>
</section>
