---
import { work, workMarks } from "../data/content";
---

<section id="work" class="reveal mb-24 md:mb-40" aria-labelledby="work-heading">
  <p class="label mb-3 text-[var(--color-ink-soft)]">Work</p>
  <h2
    id="work-heading"
    class="font-display max-w-[14ch] text-[clamp(1.85rem,6vw,3.25rem)] leading-[1.08] tracking-[-0.025em]"
  >
    Selected Work
  </h2>
  <p class="mt-4 max-w-[min(36ch,100%)] text-[var(--color-ink-soft)] md:mt-5">
    Từ yêu cầu rối đến hệ thống chạy: prototype, SRS, đào tạo, golive.
  </p>

  <ul class="work-list mt-10 list-none space-y-0 p-0 md:mt-14">
    {
      work.map((item, index) => {
        const mark = workMarks[item.id] ?? "flow";
        const offset = index % 2 === 1;
        return (
          <li
            class:list={[
              "work-item border-t border-[var(--color-rule)] py-8 last:border-b md:py-10",
              offset && "md:pl-10",
            ]}
          >
            <div class="grid gap-3 md:grid-cols-[5.5rem_minmax(0,1fr)] md:gap-10">
              <span class="font-display text-3xl leading-none tracking-[-0.04em] text-[var(--color-accent)] md:pt-1 md:text-4xl">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div class="min-w-0">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <h3 class="font-display text-[1.4rem] tracking-[-0.02em] md:text-[1.85rem]">
                    {item.name}
                  </h3>
                  <span class="text-sm text-[var(--color-ink-soft)]">
                    {item.company}
                  </span>
                </div>
                <p class="mt-1 text-sm text-[var(--color-accent)]">
                  {item.role}
                </p>
                <p class="mt-4 max-w-[48ch] leading-relaxed text-[var(--color-ink)] md:mt-5">
                  {item.impact}
                </p>
                {item.detail ? (
                  <p class="mt-2 max-w-[48ch] text-sm leading-relaxed text-[var(--color-ink-soft)]">
                    {item.detail}
                  </p>
                ) : null}
                {item.note ? (
                  <p class="mt-3 text-sm text-[var(--color-ink-soft)]">
                    {item.note}
                  </p>
                ) : null}
                <p class="label mt-4 text-[var(--color-ink-soft)] md:mt-5">
                  {item.tags.join(" · ")}
                </p>
                <div
                  class:list={["mark", `mark-${mark}`]}
                  aria-hidden="true"
                />
              </div>
            </div>
          </li>
        );
      })
    }
  </ul>
</section>
