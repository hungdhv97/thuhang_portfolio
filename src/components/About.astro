---
import { about } from "../data/content";
---

<section
  id="about"
  class="reveal mb-24 section-atmosphere md:mb-40"
  aria-labelledby="about-heading"
>
  <h2
    id="about-heading"
    class="font-display mb-8 text-[clamp(2.05rem,5.25vw,3rem)] tracking-[-0.02em] md:mb-10"
  >
    Về tôi
  </h2>
  <p
    class="pull max-w-[min(46ch,100%)] text-lg leading-[1.65] text-[var(--color-ink)] md:text-[1.4rem]"
  >
    {about.summary}
  </p>
</section>