---
import { profile } from "../data/content";

const navLinks = [
  { href: "#work", label: "Work" },
  { href: "#about", label: "About" },
  { href: "#contact", label: "Contact" },
];
---

<header
  class="letter sticky top-0 z-40 border-b border-[var(--color-rule)] bg-[color-mix(in_oklch,var(--color-paper)_86%,transparent)] py-3.5 backdrop-blur-md md:py-4"
>
  <nav class="flex h-10 items-center justify-between gap-4 md:h-11" aria-label="Primary">
    <a
      href="#top"
      class="font-display text-lg tracking-tight text-[var(--color-ink)] no-underline"
    >
      {profile.shortName}
    </a>

    <div class="flex items-center gap-4 sm:gap-6">
      <div class="hidden items-center gap-5 md:flex md:gap-7">
        {
          navLinks.map((link) => (
            <a href={link.href} class="nav-a label">
              {link.label}
            </a>
          ))
        }
      </div>

      <button
        type="button"
        class="theme-toggle label cursor-pointer border-0 bg-transparent p-0 text-[var(--color-ink-soft)] transition-colors hover:text-[var(--color-accent)] active:scale-[0.97]"
        aria-label="Chuyển giao diện"
      >
        Night
      </button>

      <button
        type="button"
        id="menu-toggle"
        class="menu-toggle relative flex h-10 w-10 items-center justify-center border-0 bg-transparent p-0 md:hidden"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        aria-label="Mở menu"
      >
        <span class="menu-toggle-bars" aria-hidden="true">
          <span class="menu-bar menu-bar-1"></span>
          <span class="menu-bar menu-bar-2"></span>
        </span>
      </button>
    </div>
  </nav>
</header>

<div
  id="menu-backdrop"
  class="menu-backdrop"
  hidden
  aria-hidden="true"
></div>

<aside
  id="mobile-drawer"
  class="mobile-drawer"
  hidden
  aria-hidden="true"
  aria-label="Menu điều hướng"
>
  <div class="mobile-drawer-inner">
    <p class="label mb-8 text-[var(--color-ink-soft)]">{profile.role}</p>
    <nav class="flex flex-col gap-1" aria-label="Mobile">
      {
        navLinks.map((link, i) => (
          <a
            href={link.href}
            class="drawer-link font-display text-[2rem] tracking-[-0.02em] text-[var(--color-ink)] no-underline"
            style={`--i: ${i}`}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</aside>

<script>
  function initMobileMenu() {
    const toggle = document.getElementById("menu-toggle");
    const drawer = document.getElementById("mobile-drawer");
    const backdrop = document.getElementById("menu-backdrop");
    if (!toggle || !drawer || !backdrop) return;

    const links = Array.from(drawer.querySelectorAll("a"));
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    let open = false;
    /** @type {HTMLElement | null} */
    let lastFocus = null;

    const setOpen = (next: boolean) => {
      open = next;
      document.documentElement.classList.toggle("menu-open", next);
      toggle.setAttribute("aria-expanded", String(next));
      toggle.setAttribute("aria-label", next ? "Đóng menu" : "Mở menu");
      drawer.hidden = false;
      backdrop.hidden = false;
      drawer.setAttribute("aria-hidden", String(!next));
      backdrop.setAttribute("aria-hidden", String(!next));

      if (next) {
        lastFocus = document.activeElement as HTMLElement;
        requestAnimationFrame(() => {
          drawer.classList.add("is-open");
          backdrop.classList.add("is-open");
          links[0]?.focus();
        });
      } else {
        drawer.classList.remove("is-open");
        backdrop.classList.remove("is-open");
        const finish = () => {
          if (!open) {
            drawer.hidden = true;
            backdrop.hidden = true;
          }
        };
        if (reduce.matches) finish();
        else setTimeout(finish, 320);
        lastFocus?.focus();
      }
    };

    toggle.addEventListener("click", () => setOpen(!open));
    backdrop.addEventListener("click", () => setOpen(false));
    links.forEach((link) => link.addEventListener("click", () => setOpen(false)));

    document.addEventListener("keydown", (e) => {
      if (!open) return;
      if (e.key === "Escape") {
        e.preventDefault();
        setOpen(false);
        return;
      }
      if (e.key !== "Tab" || links.length === 0) return;
      const focusables = [toggle, ...links];
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      const active = document.activeElement;
      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    });

    const mq = window.matchMedia("(min-width: 768px)");
    const onBreakpoint = () => {
      if (mq.matches && open) setOpen(false);
    };
    mq.addEventListener("change", onBreakpoint);
  }

  initMobileMenu();
</script>
