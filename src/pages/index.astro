---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  about,
  contact,
  education,
  experience,
  profile,
  skills,
  work,
  workMarks,
} from "../data/content";
---

<BaseLayout>
  <div class="flex min-h-dvh flex-col">
    <header
      class="letter sticky top-0 z-40 border-b border-[var(--color-rule)] bg-[color-mix(in_oklch,var(--color-paper)_86%,transparent)] py-4 backdrop-blur-md"
    >
      <nav class="flex items-center justify-between gap-4">
        <a
          href="#top"
          class="font-display text-lg tracking-tight text-[var(--color-ink)] no-underline"
        >
          {profile.shortName}
        </a>
        <div class="flex items-center gap-5 sm:gap-7">
          <a href="#work" class="nav-a label hidden sm:inline">Work</a>
          <a href="#about" class="nav-a label hidden sm:inline">About</a>
          <a href="#contact" class="nav-a label">Contact</a>
          <button
            type="button"
            id="theme-toggle"
            class="label cursor-pointer border-0 bg-transparent p-0 text-[var(--color-ink-soft)] transition-colors hover:text-[var(--color-accent)]"
          >
            Night
          </button>
        </div>
      </nav>
    </header>

    <main id="top" class="letter flex-1 pb-28 pt-16 md:pt-28">
      <section class="reveal mb-32 md:mb-40" aria-labelledby="hero-name">
        <p class="label mb-8 text-[var(--color-accent)]">{profile.role}</p>
        <h1
          id="hero-name"
          class="font-display max-w-[12ch] text-[clamp(3rem,9vw,5.5rem)] leading-[0.98] tracking-[-0.03em] text-balance text-[var(--color-ink)]"
        >
          {profile.name}
        </h1>
        <p
          class="mt-10 max-w-[28ch] text-[1.35rem] leading-snug tracking-[-0.01em] text-[var(--color-ink)] md:text-[1.65rem]"
        >
          {profile.headline}
        </p>
        <p
          class="mt-5 max-w-[40ch] text-base leading-relaxed text-[var(--color-ink-soft)] md:text-lg"
        >
          {profile.support}
        </p>
        <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href="#work" class="cta-solid">Xem dự án</a>
          <a href="#contact" class="cta-text">
            Liên hệ <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>

      <section
        id="about"
        class="reveal mb-32 md:mb-40"
        aria-labelledby="about-heading"
      >
        <div
          class="mb-10 flex items-end justify-between gap-6 border-b border-[var(--color-rule)] pb-4"
        >
          <div>
            <p class="label mb-3 text-[var(--color-ink-soft)]">About</p>
            <h2
              id="about-heading"
              class="font-display text-[clamp(2rem,4vw,2.75rem)] tracking-[-0.02em]"
            >
              Về tôi
            </h2>
          </div>
          <p class="label hidden text-[var(--color-accent)] sm:block">
            {about.location}
          </p>
        </div>
        <p
          class="pull max-w-[46ch] text-lg leading-[1.65] text-[var(--color-ink)] md:text-xl"
        >
          {about.summary}
        </p>
        <p class="label mt-8 text-[var(--color-accent)] sm:hidden">
          {about.location}
        </p>
      </section>

      <section
        id="work"
        class="reveal mb-32 md:mb-40"
        aria-labelledby="work-heading"
      >
        <p class="label mb-3 text-[var(--color-ink-soft)]">Work</p>
        <h2
          id="work-heading"
          class="font-display max-w-[14ch] text-[clamp(2.25rem,5vw,3.25rem)] leading-[1.05] tracking-[-0.025em]"
        >
          Selected Work
        </h2>
        <p class="mt-5 max-w-[36ch] text-[var(--color-ink-soft)]">
          Từ yêu cầu rối đến hệ thống chạy — prototype, SRS, đào tạo, golive.
        </p>

        <ul class="work-list mt-14 list-none space-y-0 p-0">
          {
            work.map((item, index) => {
              const mark = workMarks[item.id] ?? "flow";
              const offset = index % 2 === 1;
              return (
                <li
                  class:list={[
                    "work-item border-t border-[var(--color-rule)] py-10 last:border-b",
                    offset && "md:pl-10",
                  ]}
                >
                  <div class="grid gap-6 md:grid-cols-[5.5rem_minmax(0,1fr)] md:gap-10">
                    <span class="font-display text-4xl leading-none tracking-[-0.04em] text-[var(--color-accent)] md:pt-1">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <div>
                      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                        <h3 class="font-display text-[1.65rem] tracking-[-0.02em] md:text-[1.85rem]">
                          {item.name}
                        </h3>
                        <span class="text-sm text-[var(--color-ink-soft)]">
                          {item.company}
                        </span>
                      </div>
                      <p class="mt-1 text-sm text-[var(--color-accent)]">
                        {item.role}
                      </p>
                      <p class="mt-5 max-w-[48ch] leading-relaxed text-[var(--color-ink)]">
                        {item.impact}
                      </p>
                      {item.detail ? (
                        <p class="mt-2 max-w-[48ch] text-sm leading-relaxed text-[var(--color-ink-soft)]">
                          {item.detail}
                        </p>
                      ) : null}
                      {item.note ? (
                        <p class="mt-3 text-sm text-[var(--color-ink-soft)]">
                          {item.note}
                        </p>
                      ) : null}
                      <p class="label mt-5 text-[var(--color-ink-soft)]">
                        {item.tags.join(" · ")}
                      </p>
                      <div
                        class:list={["mark", `mark-${mark}`]}
                        aria-hidden="true"
                      />
                    </div>
                  </div>
                </li>
              );
            })
          }
        </ul>
      </section>

      <section
        id="experience"
        class="reveal mb-32 md:mb-40"
        aria-labelledby="experience-heading"
      >
        <div class="grid gap-10 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] md:gap-16">
          <div>
            <p class="label mb-3 text-[var(--color-ink-soft)]">Experience</p>
            <h2
              id="experience-heading"
              class="font-display text-[clamp(2rem,4vw,2.75rem)] tracking-[-0.02em]"
            >
              Kinh nghiệm
            </h2>
            <p class="mt-4 max-w-[28ch] text-sm leading-relaxed text-[var(--color-ink-soft)]">
              {education.degree}
              <br />
              {education.school}
              <br />
              {education.period} · {education.gpa}
            </p>
          </div>
          <ol class="m-0 list-none border-l border-[var(--color-rule)] p-0 pl-6">
            {
              experience.map((job) => (
                <li class="relative pb-8 last:pb-0">
                  <span
                    class="absolute top-1.5 -left-[1.7rem] h-2 w-2 rounded-full bg-[var(--color-accent)]"
                    aria-hidden="true"
                  />
                  <p class="label text-[var(--color-ink-soft)]">{job.period}</p>
                  <p
                    class:list={[
                      "mt-2",
                      job.compact
                        ? "text-[var(--color-ink-soft)]"
                        : "font-medium text-[var(--color-ink)]",
                    ]}
                  >
                    {job.company}
                  </p>
                  <p class="mt-1 text-sm text-[var(--color-ink-soft)]">
                    {job.role}
                  </p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section
        id="skills"
        class="reveal mb-32 md:mb-40"
        aria-labelledby="skills-heading"
      >
        <p class="label mb-3 text-[var(--color-ink-soft)]">Skills</p>
        <h2
          id="skills-heading"
          class="font-display text-[clamp(2rem,4vw,2.75rem)] tracking-[-0.02em]"
        >
          Kỹ năng
        </h2>
        <div class="mt-12 grid gap-10 sm:grid-cols-3 sm:gap-8">
          <div class="skill-col">
            <p class="label text-[var(--color-accent)]">BA</p>
            <ul>
              {skills.ba.map((s) => <li>{s}</li>)}
            </ul>
          </div>
          <div class="skill-col">
            <p class="label text-[var(--color-accent)]">Domain</p>
            <ul>
              {skills.domain.map((s) => <li>{s}</li>)}
            </ul>
          </div>
          <div class="skill-col">
            <p class="label text-[var(--color-accent)]">Soft</p>
            <ul>
              {skills.soft.map((s) => <li>{s}</li>)}
              <li>{skills.language}</li>
            </ul>
          </div>
        </div>
      </section>

      <section id="contact" class="reveal" aria-labelledby="contact-heading">
        <div class="border-t border-[var(--color-rule)] pt-14">
          <p class="label mb-3 text-[var(--color-ink-soft)]">Contact</p>
          <h2
            id="contact-heading"
            class="font-display text-[clamp(2.25rem,5vw,3.25rem)] tracking-[-0.025em]"
          >
            Cùng làm rõ
            <br />
            bài toán tiếp theo.
          </h2>
          <p class="mt-5 max-w-[34ch] text-[var(--color-ink-soft)]">
            Sẵn sàng trao đổi về vai trò BA trong HRM, ERP và chuyển đổi số.
          </p>
          <dl class="mt-12 m-0 grid gap-8 sm:grid-cols-2">
            <div>
              <dt class="label text-[var(--color-ink-soft)]">Email</dt>
              <dd class="m-0 mt-2">
                <a href={`mailto:${contact.email}`} class="cta-text text-lg">
                  {contact.email}
                </a>
              </dd>
            </div>
            <div>
              <dt class="label text-[var(--color-ink-soft)]">Phone</dt>
              <dd class="m-0 mt-2">
                <a
                  href={`tel:${contact.phone.replace(/\s/g, "")}`}
                  class="cta-text text-lg"
                >
                  {contact.phone}
                </a>
              </dd>
            </div>
            <div class="sm:col-span-2">
              <dt class="label text-[var(--color-ink-soft)]">Portfolio</dt>
              <dd class="m-0 mt-2">
                <a
                  href={contact.portfolioUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cta-text text-lg"
                >
                  {contact.portfolioLabel}
                </a>
              </dd>
            </div>
          </dl>
        </div>
      </section>
    </main>

    <footer class="letter border-t border-[var(--color-rule)] py-12">
      <div
        class="flex flex-col gap-3 sm:flex-row sm:items-baseline sm:justify-between"
      >
        <p class="font-display text-xl tracking-tight">{profile.name}</p>
        <p class="label text-[var(--color-ink-soft)]">{profile.role}</p>
      </div>
      <p class="mt-6 text-sm text-[var(--color-ink-soft)]">
        Astro · Editorial Letter · Nội dung từ CV
      </p>
    </footer>
  </div>
</BaseLayout>
